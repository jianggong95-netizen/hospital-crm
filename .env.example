# =====================================================================
# Hospital CRM 本地开发环境变量示例
# 复制为 .env 后使用：Copy-Item .env.example .env
# 生产环境禁止沿用以下默认值，必须使用医院密钥管理系统或受控 Secret。
# =====================================================================

# PostgreSQL
CRM_DB_NAME=crm
CRM_DB_USERNAME=crm
CRM_DB_PASSWORD=crm_dev_password
CRM_DB_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=crm
RABBITMQ_DEFAULT_PASS=crm_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ROOT_USER=crmadmin
MINIO_ROOT_PASSWORD=crm_dev_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# CRM API
SPRING_PROFILES_ACTIVE=dev
CRM_API_PORT=8080

# CRM-002 认证与安全
# 生产环境必须替换为至少 32 字节的随机密钥，并通过受控 Secret 注入
CRM_JWT_SIGNING_KEY=dev-only-hospital-crm-signing-key-change-me-32bytes
CRM_JWT_ACCESS_MINUTES=15
CRM_JWT_REFRESH_DAYS=7
CRM_LOGIN_MAX_FAILED_ATTEMPTS=5
CRM_LOGIN_LOCK_MINUTES=15

# 首次启动自动创建的管理员账号（生产环境必须显式配置强密码）
CRM_BOOTSTRAP_ADMIN_ENABLED=true
CRM_BOOTSTRAP_ADMIN_USERNAME=admin
CRM_BOOTSTRAP_ADMIN_PASSWORD=Crm@123456
CRM_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# CRM-003 客户敏感字段加密：Base64 编码的 32 字节 AES-256 密钥
# 生产环境必须单独生成并妥善保管，更换密钥会导致历史密文无法解密
CRM_DATA_ENCRYPTION_KEY=ZGV2LW9ubHktY3VzdG9tZXItZGF0YS1rZXktMzJieXQ=

# CRM-005 HIS 集成（SQL Server 只读账号）
# 默认关闭；未配置时 HIS 接口 fail-closed 返回 503
CRM_HIS_ENABLED=false
CRM_HIS_URL=
CRM_HIS_USERNAME=
CRM_HIS_PASSWORD=
CRM_HIS_READ_ONLY_CHECK=true
CRM_HIS_QUERY_TIMEOUT_SECONDS=5
CRM_HIS_SEARCH_LIMIT=20
CRM_HIS_BREAKER_FAILURE_THRESHOLD=5
CRM_HIS_BREAKER_OPEN_SECONDS=30
# 医院确认的只读视图与字段映射，示例值不代表真实医院表结构
CRM_HIS_PATIENT_VIEW=dbo.v_crm_patient
CRM_HIS_VISIT_VIEW=dbo.v_crm_visit
CRM_HIS_ADMISSION_VIEW=dbo.v_crm_admission

# CRM-006 患者360（HIS 聚合结果短时缓存与诊疗分区分页）
# 缓存仅减少重复 HIS 调用；HIS 不可用时仍按 CRM-005 规则返回 STALE 或 UNAVAILABLE
CRM_PATIENT360_CACHE_TTL_SECONDS=60
CRM_PATIENT360_CACHE_MAX_ENTRIES=500
CRM_PATIENT360_DEFAULT_PAGE_SIZE=10
CRM_PATIENT360_MAX_PAGE_SIZE=50

# 前端
CRM_ADMIN_PORT=8081
CRM_PATIENT_PORT=8082
