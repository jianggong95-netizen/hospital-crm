<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.hospital.crm</groupId>
    <artifactId>crm-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>crm-boot</artifactId>
  <name>CRM Boot</name>
  <description>Spring Boot 启动模块：Web 配置、统一异常、Flyway 迁移与运行时装配</description>

  <dependencies>
    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-system</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-customer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-family</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-his</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-patient360</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-operation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-appointment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-escort</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-homevisit</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-order</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-member</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-followup</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-complaint</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.hospital.crm</groupId>
      <artifactId>crm-chat</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>crm-api</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.hospital.crm.CrmApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
