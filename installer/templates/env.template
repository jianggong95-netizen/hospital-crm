# =====================================================================
# Hospital CRM runtime configuration
# Auto-generated by the installer; or copy this template to config\.env.
# Upgrades never overwrite this file. Edit and restart to apply changes.
# =====================================================================

# HTTP port (admin console + API + Swagger share this single process)
CRM_SERVER_PORT=8080

# Database
# CRM_INTERNAL_DB=true  -> start.ps1 uses the bundled portable PostgreSQL ({app}\pgsql + {app}\pgdata)
# CRM_INTERNAL_DB=false -> connect to the external server given by CRM_DB_URL
CRM_INTERNAL_DB=true
CRM_DB_NAME=crm
CRM_DB_USERNAME=crm
CRM_DB_PASSWORD=
CRM_DB_PORT=5432
CRM_DB_URL=jdbc:postgresql://127.0.0.1:5432/crm

# Security keys (generated randomly by the installer; keep them safe)
CRM_JWT_SIGNING_KEY=
CRM_DATA_ENCRYPTION_KEY=

# Admin account created on first start
CRM_BOOTSTRAP_ADMIN_ENABLED=true
CRM_BOOTSTRAP_ADMIN_USERNAME=admin
CRM_BOOTSTRAP_ADMIN_PASSWORD=
CRM_BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator

# CORS (single-process same-origin deploy usually needs none; kept for split setups)
CRM_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Allow anonymous Prometheus scraping (demo / intranet ok; public hosts must restrict via reverse proxy)
CRM_OPS_METRICS_PUBLIC=true

# HIS integration (disabled by default)
CRM_HIS_ENABLED=false
CRM_HIS_URL=
CRM_HIS_USERNAME=
CRM_HIS_PASSWORD=

# Log directory (empty -> {app}\logs)
CRM_LOG_PATH=
